# ─────────────────────────────────────────────────────────────
#  NeuSix website: environment variables
#  Copy to `.env.local` for local development. On Hostinger, add
#  the same keys under the Node.js app's "Environment variables".
# ─────────────────────────────────────────────────────────────

# Public URL of the site (used for canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.neusix.com

# ── Contact form delivery ────────────────────────────────────
# At least ONE channel must be configured, otherwise the form shows
# "Oops! Something went wrong while submitting the form." (it never fakes success).

# Option A: SMTP (e.g. a Hostinger business mailbox: smtp.hostinger.com, port 465)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=website@neusix.com
SMTP_PASS=change-me
# Inbox that receives enquiries (comma-separate several addresses)
CONTACT_TO=hello@neusix.com
# Optional "From" address (defaults to SMTP_USER). Must be allowed by your SMTP server.
CONTACT_FROM="NeuSix Website <website@neusix.com>"

# Option B (optional, can be used together with A): POST each enquiry as JSON
# to a CRM / Zapier / Make / HubSpot workflow webhook.
# CONTACT_WEBHOOK_URL=https://hooks.example.com/neusix-contact
